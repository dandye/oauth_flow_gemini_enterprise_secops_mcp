# ==============================================================================
# Environment Configuration for oauth_flow_gemini_enterprise_secops_mcp
# ==============================================================================

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# STAGE 1: Google Cloud & Chronicle SIEM Prerequisites
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_LOCATION=us-central1
GCP_STAGING_BUCKET=gs://your-staging-bucket

CHRONICLE_PROJECT_ID=your-chronicle-project-id
CHRONICLE_CUSTOMER_ID=00000000-0000-0000-0000-000000000000
CHRONICLE_LOCATION=us
CHRONICLE_REGION=us

# Cloudtop mTLS Bypass
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_API_USE_MTLS_ENDPOINT=never
CLOUDSDK_CONTEXT_AWARE_USE_CLIENT_CERTIFICATE=false
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# STAGE 2: Vertex AI Agent Engine Deployment Outputs
AGENT_ENGINE_RESOURCE_NAME=
AGENT_ENGINE_ID=

# STAGE 3: Gemini Enterprise / AgentSpace Integration
AGENTSPACE_APP_ID=your-agentspace-app-id
AGENTSPACE_COLLECTION=default_collection
AGENTSPACE_ASSISTANT=default_assistant
AGENTSPACE_AGENT_ID=

# STAGE 4: OAuth Passthrough Configuration
OAUTH_AUTH_ID=gement-onemcp-auth-passthrough-v1
GEMINI_AUTHORIZATION_ID=gement-onemcp-auth-passthrough-v1
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URI=
OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
